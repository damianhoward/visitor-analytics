# Baseline hardening on every response. frame-ancestors is 'self', not 'none', because the
# trading desk frames the composed front ends through its own gateway origin.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
	}
}

orderbook.damianhoward.com {
	import security_headers
	encode zstd gzip
	log {
		output file /var/log/caddy/orderbook.log {
			mode 0644
		}
		format json
	}
	reverse_proxy localhost:8080 {
		flush_interval -1
	}
}

