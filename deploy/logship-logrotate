# Bounds the copy of box 2's trading access log that lives on this host. Caddy rotates its own
# logs (100 MiB roll, 10 kept, 90 days), but this file is appended by logship-fetch and had no
# bound at all, so the trading site's raw log was retained here indefinitely while the privacy
# notice promised 90 days.
#
# The tailer restarts at offset zero when a file shrinks, so rotation costs at most the lines
# written between its last read and the rotation — the same window Caddy's own rolling already
# has. `create` keeps ownership so logship-fetch can carry on appending.
/var/log/remote/*.log {
    daily
    rotate 90
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    create 0644 ubuntu ubuntu
}
