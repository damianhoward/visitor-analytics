[Unit]
Description=Visitor analytics over the live sites' Caddy access logs
After=network.target

[Service]
Environment=JAVA_HOME=/opt/jdk25
Environment=JAVA_OPTS=-Xmx96m
# Box-local config: Caddy log paths, DB triple, GeoLite2 paths, hash salt, buffer path, PORT.
EnvironmentFile=/etc/visitor-analytics/env
ExecStart=/home/ubuntu/visitor-analytics/bin/visitor-analytics
Restart=on-failure
RestartSec=2
User=ubuntu

# Sandboxing. This service reads the other sites' access logs and holds a database credential and
# the IP hash salt, so the blast radius of a defect in it is worth bounding. The filesystem is
# read-only apart from the one directory it owns; the rest are capabilities it has no use for.
# `systemd-analyze security visitor-analytics.service` reports the result.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Everything it writes lives here: the visit buffer and the tailer's byte offsets. /etc holds the
# env file and the Oracle wallet, /var/log and /var/lib/GeoIP the inputs — all read-only under
# ProtectSystem=strict, which is what they should be.
ReadWritePaths=/var/lib/visitor-analytics
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# MemoryDenyWriteExecute is deliberately absent rather than false: the JVM writes JIT-compiled code
# and then executes it, so enabling it kills the process on the first compilation.
#
# Above the 96 MB heap with room for metaspace, code cache and thread stacks. The point is to bound
# a leak into a restart rather than let one tenant of a 1 GB box take the other services with it.
MemoryMax=256M
TasksMax=256

[Install]
WantedBy=multi-user.target
